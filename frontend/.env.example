# Copy to .env.local and fill in. These values are public: they ship in the browser bundle.
# Never put a Supabase secret or service_role key here.
VITE_SUPABASE_URL=
# Supabase dashboard > Project Settings > API Keys > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Leave empty in development (Vite forwards /api to Django). Set to the API's URL in production.
VITE_API_URL=
